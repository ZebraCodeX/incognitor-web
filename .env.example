# Local development environment for Incognitor.
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#   python -c "import secrets; print('DJANGO_SECRET_KEY=' + secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print('FIELD_ENCRYPTION_KEY=' + Fernet.generate_key().decode())"

# --- Core ---
DEBUG=True
DJANGO_SECRET_KEY=change-me-generate-a-real-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_PATH=db.sqlite3

# --- Zero-knowledge crypto keys ---
# BLIND_INDEX_KEY defaults to SECRET_KEY if unset; set explicitly for rotation.
# BLIND_INDEX_KEY=
FIELD_ENCRYPTION_KEY=

# --- Security toggles (production) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSP_ENFORCE=True
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Browser-extension origins allowed to call the API with a token.
# CORS_ALLOWED_ORIGIN_REGEXES=^chrome-extension://.*$,^moz-extension://.*$
# REQUIRE_EMAIL_VERIFICATION=True

# --- Exposure sources (all optional; disabled when empty) ---
HIBP_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GITHUB_TOKEN=
# Optional pluggable providers.
PUBLIC_RECORDS_API_URL=
PUBLIC_RECORDS_API_KEY=
# Licensed dark-web / breach-intelligence feed (never self-scrape Tor).
DARKWEB_FEED_URL=
DARKWEB_FEED_API_KEY=

# --- Web Push (VAPID) browser notifications ---
# Generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=privacy@incognitor.app

# --- Sentinel agent ---
SENTINEL_AUTO_REMOVE=True
SENTINEL_MAX_SENDS_PER_DAY=200
SENTINEL_MONITOR_INTERVAL_HOURS=24
SENTINEL_VERIFY_INTERVAL_DAYS=7
SENTINEL_REMOVAL_DEADLINE_DAYS=30
# Comma-separated host allowlist for the web-form engine (SSRF protection).
# SENTINEL_ALLOWED_WEBFORM_HOSTS=www.beenverified.com,www.spokeo.com

# --- Email / SMTP (removal letters) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=privacy@incognitor.app

# --- Celery (optional; falls back to in-process scheduler) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
